<mxfile host="app.diagrams.net"><diagram id="erd" name="ERD quan niệm"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1060" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="LSHH" value="LỊCH SỬ HOA HỒNG" style="swimlane;fontStyle=1;horizontal=1;startSize=30;collapsible=0;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="210" height="100" as="geometry"/></mxCell><mxCell id="LSHH_a" value="&lt;u&gt;&lt;b&gt;Mã hoa hồng&lt;/b&gt;&lt;/u&gt;&lt;br&gt;Ngày bắt đầu&lt;br&gt;Ngày kết thúc&lt;br&gt;Hoa hồng mỗi buổi" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=none;strokeColor=none;fontSize=12;" vertex="1" parent="LSHH"><mxGeometry y="30" width="210" height="70" as="geometry"/></mxCell><mxCell id="CN" value="CHI NHÁNH" style="swimlane;fontStyle=1;horizontal=1;startSize=30;collapsible=0;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="210" height="145" as="geometry"/></mxCell><mxCell id="CN_a" value="&lt;u&gt;&lt;b&gt;Mã chi nhánh&lt;/b&gt;&lt;/u&gt;&lt;br&gt;Tên chi nhánh&lt;br&gt;Địa chỉ&lt;br&gt;Số điện thoại&lt;br&gt;Giờ mở cửa&lt;br&gt;Giờ đóng cửa&lt;br&gt;Sức chứa" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=none;strokeColor=none;fontSize=12;" vertex="1" parent="CN"><mxGeometry y="30" width="210" height="115" as="geometry"/></mxCell><mxCell id="CT" value="CÔNG TÁC" style="swimlane;fontStyle=1;horizontal=1;startSize=30;collapsible=0;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="60" width="210" height="100" as="geometry"/></mxCell><mxCell id="CT_a" value="&lt;u&gt;&lt;b&gt;Mã công tác&lt;/b&gt;&lt;/u&gt;&lt;br&gt;Chức vụ&lt;br&gt;Ngày bắt đầu&lt;br&gt;Ngày kết thúc" style="text;html=1;align=left;verticalAlign=top;spacingLeft=